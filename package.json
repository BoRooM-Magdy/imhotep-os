{
    "name": "imhotep-os",
    "private": true,
    "version": "1.0.2",
    "type": "module",
    "description": "Sovereign AI Engineering Studio",
    "author": "Imhotep OS Team",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "electron:start": "electron .",
        "dist": "npm run build && electron-builder"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.7.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "chokidar": "^3.6.0",
        "node-pty": "^1.1.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.1.12",
        "@vitejs/plugin-react": "4.7.0",
        "electron": "^43.1.1",
        "electron-builder": "^26.15.3",
        "electron-packager": "^17.1.2",
        "tailwindcss": "4.1.12",
        "typescript": "^7.0.2",
        "vite": "6.3.5",
        "vite-plugin-monaco-editor": "^1.1.0"
    },
    "build": {
        "npmRebuild": false,
        "asar": false,
        "appId": "com.imhotep.os",
        "productName": "Imhotep OS",
        "win": {
            "target": "nsis",
            "artifactName": "Imhotep_OS_Setup.exe"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "runAfterFinish": true,
            "deleteAppDataOnUninstall": true
        },
        "directories": {
            "output": "E:/work/imhotep-os/release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "splash/**/*",
            "package.json"
        ]
    }
}
